we need to on# n8n production configuration for high traffic (1,000+ candidates/day)
# Put these under [n8n] in your n8n config file (n8n.config.js or env vars).

# Keep execution history small — required for sustained high throughput.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=72
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# Don't bloat the database with workflow bodies or unneeded data.
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false

# Free up the workflow itself right after it runs.
EXECUTIONS_DATA_SAVE_ON_NODE_FAILURE=none
EXECUTIONS_MODE=queue

# Only keep these few events in the execution log.
EXECUTIONS_PROCESS=main
N8N_METRICS=true
N8N_METRICS_INCLUDE_QUEUE_METRICS=true
