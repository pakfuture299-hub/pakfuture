      "typeVersion": 2,
      "position": [-140, 300]
    },
    {
      "parameters": {
        "jsCode": "// Normalize the incoming payload before it is stored.\n// - trim strings\n// - fall back to the webhook timestamp when missing\n// - derive the spreadsheet columns: Timestamp, Name, Phone, Telegram, Source, Status\nconst item = $input.first().json;\n\nconst now = new Date();\nconst ts = (item.timestamp && !isNaN(Date.parse(item.timestamp)))\n  ? new Date(item.timestamp).toISOString()\n  : now.toISOString();\n\nconst source = item.source || 'Shopify Chatbot';\n\nreturn [{\n  json: {\n    timestamp: ts,\n    name: String(item.name || '').trim(),\n    phone: String(item.phone || '').trim(),\n    telegram: String(item.telegram || '').trim(),\n    source: source,\n    status: item.status || 'New'\n  }\n}];",
        "language": "javaScript"
      },
      "id": "c87d6b35-6f7a-4a3b-bee2-92b1c24f5f03",
      "name": "Normalize & Prepare Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1RydPOjz_FZwr_GCISb2lrwQ42iejL3-U7ha86AChwFo",
          "mode": "id"
        },
        "sheetName": {
          "value": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $json.timestamp }}",
            "name": "={{ $json.name }}",
            "phone": "={{ $json.phone }}",
            "telegram": "={{ $json.telegram }}",
            "source": "={{ $json.source }}",
            "status": "={{ $json.status }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "c87d6b35-6f7a-4a3b-bee2-92b1c24f5f04",
