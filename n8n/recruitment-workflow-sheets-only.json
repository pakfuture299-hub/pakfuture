    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst now = new Date();\nconst ts = (item.timestamp && !isNaN(Date.parse(item.timestamp)))\n  ? new Date(item.timestamp).toISOString()\n  : now.toISOString();\n\nconst source = item.source || 'Shopify Chatbot';\n\nreturn [{\n  json: {\n    timestamp: ts,\n    name: String(item.name || '').trim(),\n    phone: String(item.phone || '').trim(),\n    telegram: String(item.telegram || '').trim(),\n    source: source,\n    status: item.status || 'New'\n  }\n}];",
        "language": "javaScript"
      },
