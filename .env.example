# ------------------------------------------------------------------
# Job Portal Chatbot — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# --- Server ---
PORT=3000
# Allowed origins for the CORS preflight / health endpoint (comma separated).
ALLOWED_ORIGINS=https://job-portal-global.myshopify.com
NODE_ENV=production

# --- OpenAI (ChatGPT API, used for intent + FAQ answers) ---
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Telegram invite link (the ONLY thing the widget hands out) ---
INVITE_LINK=https://t.me/+923244362726

# --- n8n webhook (OPTIONAL — only if you keep the old Telegram-bot intake) ---
# Not needed for the storefront widget. Leave commented out unless you use it.
# N8N_WEBHOOK_URL=

# --- Telegram Bot (OPTIONAL — not needed for the storefront widget) ---
# Only used by the legacy Telegram-bot conversation flow.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# --- Shopify (optional webhook integration) ---
# Only needed if you subscribe to Shopify storefront cart/order webhooks.
# Leave blank to disable.
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_ACCESS_TOKEN=

# --- Google Sheets (via n8n) ---
# The n8n Google Sheets node holds the service-account JSON internally.
# Optionally point n8n at a mounted credentials file on the VPS:
GOOGLE_CREDENTIALS_PATH=

# --- Spam & safety ---
# Max messages a single chat may send per minute before it is throttled.
RATE_LIMIT_PER_MINUTE=10
# Cooldown (ms) a candidate must wait before a second submission is accepted.
DUPLICATE_COOLDOWN_MS=3600000
# Maximum session age in ms (10 hours) before we force a fresh start.
SESSION_TTL_MS=36000000
